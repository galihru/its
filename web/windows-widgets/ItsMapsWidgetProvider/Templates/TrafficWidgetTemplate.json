{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "ColumnSet",
      "spacing": "None",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            { "type": "TextBlock", "text": "${systemId}", "weight": "Bolder", "color": "Default", "wrap": true },
            { "type": "TextBlock", "text": "${systemLine}", "size": "Small", "color": "Default", "isSubtle": true, "spacing": "None", "wrap": true }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "items": [
            { "type": "TextBlock", "text": "${statusLabel}", "size": "Small", "weight": "Bolder", "color": "${statusTextColor}", "horizontalAlignment": "Right" }
          ]
        }
      ]
    },
    {
      "type": "ColumnSet",
      "spacing": "Small",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            { "type": "TextBlock", "text": "${vehicleCountText}", "size": "Large", "weight": "Bolder", "color": "Default" },
            { "type": "TextBlock", "text": "kendaraan", "size": "Small", "color": "Default", "isSubtle": true, "spacing": "None" }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "items": [
            { "type": "TextBlock", "text": "${trafficStatusLine}", "weight": "Bolder", "color": "${statusColor}", "horizontalAlignment": "Right", "wrap": true }
          ]
        }
      ]
    },
    { "type": "Image", "url": "${chartImage}", "altText": "${chartFrame}", "size": "Stretch", "spacing": "Small" },
    {
      "type": "ColumnSet",
      "spacing": "Small",
      "columns": [
        { "type": "Column", "width": "stretch", "items": [ { "type": "Image", "url": "${iconCar}", "width": "22px" }, { "type": "TextBlock", "text": "Mobil", "size": "Small", "color": "Default", "isSubtle": true, "spacing": "None" }, { "type": "TextBlock", "text": "${carText}", "weight": "Bolder", "color": "Accent", "spacing": "None" } ] },
        { "type": "Column", "width": "stretch", "items": [ { "type": "Image", "url": "${iconMotor}", "width": "22px" }, { "type": "TextBlock", "text": "Motor", "size": "Small", "color": "Default", "isSubtle": true, "spacing": "None" }, { "type": "TextBlock", "text": "${motorcycleText}", "weight": "Bolder", "color": "Accent", "spacing": "None" } ] },
        { "type": "Column", "width": "stretch", "items": [ { "type": "Image", "url": "${iconBike}", "width": "22px" }, { "type": "TextBlock", "text": "Sepeda", "size": "Small", "color": "Default", "isSubtle": true, "spacing": "None" }, { "type": "TextBlock", "text": "${bicycleText}", "weight": "Bolder", "color": "Accent", "spacing": "None" } ] }
      ]
    },
    {
      "type": "ColumnSet",
      "spacing": "Small",
      "columns": [
        { "type": "Column", "width": "stretch", "items": [ { "type": "Image", "url": "${iconBus}", "width": "22px" }, { "type": "TextBlock", "text": "Bus", "size": "Small", "color": "Default", "isSubtle": true, "spacing": "None" }, { "type": "TextBlock", "text": "${busText}", "weight": "Bolder", "color": "Accent", "spacing": "None" } ] },
        { "type": "Column", "width": "stretch", "items": [ { "type": "Image", "url": "${iconTruck}", "width": "22px" }, { "type": "TextBlock", "text": "Truk", "size": "Small", "color": "Default", "isSubtle": true, "spacing": "None" }, { "type": "TextBlock", "text": "${truckText}", "weight": "Bolder", "color": "Accent", "spacing": "None" } ] },
        { "type": "Column", "width": "stretch", "items": [ { "type": "Image", "url": "${iconTotal}", "width": "22px" }, { "type": "TextBlock", "text": "Total", "size": "Small", "color": "Default", "isSubtle": true, "spacing": "None" }, { "type": "TextBlock", "text": "${vehicleCountText}", "weight": "Bolder", "color": "Accent", "spacing": "None" } ] }
      ]
    }
  ]
}
