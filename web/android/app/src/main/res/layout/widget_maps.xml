<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_maps_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="0dp">

    <ImageView
        android:id="@+id/widget_maps_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_alignParentBottom="true"
        android:background="@drawable/widget_panel"
        android:contentDescription="Preview peta realtime"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/widget_maps_locations"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_maps_location_user"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/widget_panel"
            android:contentDescription="Lokasi saya"
            android:padding="10dp"
            android:src="@drawable/ic_widget_location_user" />

        <ImageView
            android:id="@+id/widget_maps_location_raspi"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_panel"
            android:contentDescription="Raspberry Pi"
            android:padding="10dp"
            android:src="@drawable/ic_widget_location_raspi" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_maps_zoom_toggle"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/widget_panel"
        android:contentDescription="Zoom peta"
        android:padding="11dp"
        android:src="@drawable/ic_widget_map_zoom" />

    <TextView
        android:id="@+id/widget_maps_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="@drawable/widget_panel"
        android:paddingLeft="12dp"
        android:paddingTop="8dp"
        android:paddingRight="12dp"
        android:paddingBottom="8dp"
        android:text="Memuat peta..."
        android:textColor="@color/its_widget_muted"
        android:textSize="11sp"
        android:textStyle="bold" />
</RelativeLayout>
