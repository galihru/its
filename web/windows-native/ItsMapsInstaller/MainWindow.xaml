<Window x:Class="ItsMapsInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ITS Maps Windows Setup"
        Width="1100"
        Height="825"
        MinWidth="980"
        MinHeight="735"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#f7fbff"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="OnLoaded">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <DropShadowEffect x:Key="SoftButtonShadow" Color="#2d6bd8" BlurRadius="18" ShadowDepth="0" Opacity="0.16" />

    <Style x:Key="WindowButton" TargetType="Button">
      <Setter Property="Width" Value="58" />
      <Setter Property="Height" Value="72" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#1d6edf" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CloseWindowButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#e81123" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FooterButton" TargetType="Button">
      <Setter Property="Height" Value="58" />
      <Setter Property="MinWidth" Value="172" />
      <Setter Property="Padding" Value="22,0" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Effect" Value="{StaticResource SoftButtonShadow}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Effect="{TemplateBinding Effect}"
                    CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Opacity" Value="0.92" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FooterButton}">
      <Setter Property="Background" Value="#075ed6" />
      <Setter Property="BorderBrush" Value="#075ed6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource FooterButton}">
      <Setter Property="Background" Value="#fbfdff" />
      <Setter Property="BorderBrush" Value="#b8c7e5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#06123d" />
    </Style>

    <Style x:Key="FeatureIcon" TargetType="Border">
      <Setter Property="Width" Value="72" />
      <Setter Property="Height" Value="72" />
      <Setter Property="CornerRadius" Value="36" />
      <Setter Property="Background" Value="#e8f1ff" />
    </Style>

    <Style x:Key="FeaturePath" TargetType="Path">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Fill" Value="#075ed6" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <Viewbox Stretch="Uniform">
    <Grid Width="1448" Height="1086" Background="#f8fbff">
      <Image Source="{Binding CurrentBackground}" Stretch="UniformToFill" Opacity="0.98" />

      <Path Fill="#fbfdff" Opacity="0.99" Data="M0,72 L765,72 L720,966 L0,966 Z" />
      <Rectangle Height="120" VerticalAlignment="Bottom" Fill="#fbfdff" Stroke="#d1dced" StrokeThickness="1" />
      <Rectangle Height="72" VerticalAlignment="Top">
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#063fb6" Offset="0" />
            <GradientStop Color="#0867df" Offset="0.62" />
            <GradientStop Color="#2c8cff" Offset="1" />
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>

      <Grid Height="72" VerticalAlignment="Top" MouseLeftButtonDown="OnTitleBarMouseDown">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="48,0,0,0">
          <Image Source="pack://application:,,,/Assets/logo.png" Width="42" Height="42" Stretch="Uniform" Margin="0,0,14,0" />
          <TextBlock Text="ITS Maps Windows Setup"
                     Foreground="White"
                     FontFamily="Segoe UI"
                     FontSize="27"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="&#xE921;" Style="{StaticResource WindowButton}" Click="OnMinimize" />
          <Button Content="&#xE922;" Style="{StaticResource WindowButton}" Click="OnMaximizeRestore" />
          <Button Content="&#xE8BB;" Style="{StaticResource CloseWindowButton}" Click="OnClose" />
        </StackPanel>
      </Grid>

      <Canvas>
        <Rectangle Canvas.Left="102" Canvas.Top="130" Width="540" Height="2" Fill="#c5d1e7" />
        <ItemsControl Canvas.Left="74" Canvas.Top="108" ItemsSource="{Binding Steps}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Width="108" Height="92">
                <Ellipse Width="42" Height="42"
                         VerticalAlignment="Top"
                         HorizontalAlignment="Center"
                         Fill="{Binding Fill}"
                         Stroke="{Binding Stroke}"
                         StrokeThickness="1.4" />
                <TextBlock Text="{Binding Number}"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"
                           FontFamily="Segoe UI"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{Binding NumberBrush}" />
                <TextBlock Text="{Binding Label}"
                           Margin="0,58,0,0"
                           TextAlignment="Center"
                           FontFamily="Segoe UI"
                           FontSize="16"
                           FontWeight="{Binding LabelWeight}"
                           Foreground="{Binding LabelBrush}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Canvas>

      <Grid Margin="72,210,0,0" Width="670" Height="756" HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="4">
        <Image Source="pack://application:,,,/Assets/logo.png"
               Width="90"
               Height="90"
               Stretch="Uniform"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               Visibility="{Binding LogoVisibility}" />

        <Grid Height="248" VerticalAlignment="Top">
          <TextBlock Text="{Binding HeaderTitle}"
                     Margin="118,2,0,0"
                     FontFamily="Segoe UI"
                     FontSize="{Binding HeaderTitleSize}"
                     FontWeight="Bold"
                     Foreground="#06123d"
                     LineHeight="64"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding HeaderHeadline}"
                     Margin="0,116,0,0"
                     FontFamily="Segoe UI"
                     FontSize="{Binding PageTitleSize}"
                     FontWeight="Bold"
                     Foreground="#06123d"
                     LineHeight="68"
                     Visibility="{Binding HeaderHeadlineVisibility}"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding PageSubtitle}"
                     Margin="{Binding HeaderSubtitleMargin}"
                     FontFamily="Segoe UI"
                     FontSize="20"
                     LineHeight="31"
                     Foreground="#142245"
                     TextWrapping="Wrap" />
        </Grid>

        <Grid Margin="0,300,0,0" Visibility="{Binding WelcomeVisibility}">
          <Border Width="596"
                  Height="300"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Background="#ffffff"
                  BorderBrush="#d9e3f5"
                  BorderThickness="1"
                  CornerRadius="12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
              </Grid.RowDefinitions>
              <Rectangle Grid.RowSpan="2" Grid.Column="0" Width="1" Fill="#d9e3f5" HorizontalAlignment="Right" />
              <Rectangle Grid.Row="0" Grid.ColumnSpan="2" Height="1" Fill="#d9e3f5" VerticalAlignment="Bottom" />

              <Grid Margin="22">
                <Border Style="{StaticResource FeatureIcon}" HorizontalAlignment="Left" VerticalAlignment="Center">
                  <Path Style="{StaticResource FeaturePath}" Data="M12,4V1L8,5L12,9V6C15.31,6 18,8.69 18,12C18,13.01 17.75,13.96 17.3,14.8L18.76,16.26C19.54,15.03 20,13.55 20,12C20,7.58 16.42,4 12,4ZM6.7,9.2L5.24,7.74C4.46,8.97 4,10.45 4,12C4,16.42 7.58,20 12,20V23L16,19L12,15V18C8.69,18 6,15.31 6,12C6,10.99 6.25,10.04 6.7,9.2Z" />
                </Border>
                <StackPanel Margin="96,16,0,0">
                  <TextBlock Text="Sinkronisasi Realtime" FontFamily="Segoe UI" FontSize="16" FontWeight="Bold" Foreground="#06123d" TextWrapping="Wrap" />
                  <TextBlock Text="Tersinkronisasi lintas platform untuk WebApp, Android Widget, dan Raspberry Pi 5"
                             Margin="0,10,0,0" FontFamily="Segoe UI" FontSize="13" LineHeight="19" Foreground="#243659" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>

              <Grid Grid.Column="1" Margin="22">
                <Border Style="{StaticResource FeatureIcon}" HorizontalAlignment="Left" VerticalAlignment="Center">
                  <Path Style="{StaticResource FeaturePath}" Data="M20.5,3L20.34,3.03L15,5.1L9,3L3.36,4.9C3.15,4.97 3,5.15 3,5.38V20.5C3,20.78 3.22,21 3.5,21L3.66,20.97L9,18.9L15,21L20.64,19.1C20.85,19.03 21,18.85 21,18.62V3.5C21,3.22 20.78,3 20.5,3ZM10,5.47L14,6.87V18.53L10,17.13V5.47ZM5,6.46L8,5.45V17.15L5,18.15V6.46ZM19,17.54L16,18.55V6.85L19,5.85V17.54Z" />
                </Border>
                <StackPanel Margin="96,16,0,0">
                  <TextBlock Text="Peta Interaktif" FontFamily="Segoe UI" FontSize="16" FontWeight="Bold" Foreground="#06123d" TextWrapping="Wrap" />
                  <TextBlock Text="Menyajikan berbagai bentuk peta yang interaktif, informatif dan menarik"
                             Margin="0,10,0,0" FontFamily="Segoe UI" FontSize="13" LineHeight="19" Foreground="#243659" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>

              <Grid Grid.Row="1" Margin="22">
                <Border Style="{StaticResource FeatureIcon}" HorizontalAlignment="Left" VerticalAlignment="Center">
                  <Path Style="{StaticResource FeaturePath}" Data="M17,10.5V6C17,4.9 16.1,4 15,4H5C3.9,4 3,4.9 3,6V18C3,19.1 3.9,20 5,20H15C16.1,20 17,19.1 17,18V13.5L21,17.5V6.5L17,10.5Z" />
                </Border>
                <StackPanel Margin="96,16,0,0">
                  <TextBlock Text="Video Realtime AI" FontFamily="Segoe UI" FontSize="16" FontWeight="Bold" Foreground="#06123d" TextWrapping="Wrap" />
                  <TextBlock Text="Video tersaji realtime berbasis AI"
                             Margin="0,10,0,0" FontFamily="Segoe UI" FontSize="13" LineHeight="19" Foreground="#243659" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>

              <Grid Grid.Row="1" Grid.Column="1" Margin="22">
                <Border Style="{StaticResource FeatureIcon}" HorizontalAlignment="Left" VerticalAlignment="Center">
                  <Path Style="{StaticResource FeaturePath}" Data="M3,21H21V19H3V21ZM5,17H8V10H5V17ZM10.5,17H13.5V5H10.5V17ZM16,17H19V13H16V17ZM16,9.5L21,4.5L19.59,3.09L16,6.67L13.41,4.09L9.5,8L7,5.5L3.5,9L4.91,10.41L7,8.33L9.5,10.83L13.41,6.92L16,9.5Z" />
                </Border>
                <StackPanel Margin="96,16,0,0">
                  <TextBlock Text="Grafik Realtime AI" FontFamily="Segoe UI" FontSize="16" FontWeight="Bold" Foreground="#06123d" TextWrapping="Wrap" />
                  <TextBlock Text="Disajikan grafik realtime berbasis AI yang informatif dan akurat"
                             Margin="0,10,0,0" FontFamily="Segoe UI" FontSize="13" LineHeight="19" Foreground="#243659" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Grid>
          </Border>

          <StackPanel Orientation="Horizontal" Margin="0,340,0,0">
            <Border Width="28" Height="28" CornerRadius="14" Background="#075ed6">
              <TextBlock Text="&#x2713;" Foreground="White" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Aman, ringan, dan dirancang untuk performa optimal."
                       Margin="14,0,0,0"
                       VerticalAlignment="Center"
                       FontFamily="Segoe UI"
                       FontSize="18"
                       Foreground="#134aa0" />
          </StackPanel>
        </Grid>

        <Grid Margin="0,130,0,0" Width="630" Height="530" Visibility="{Binding LicenseVisibility}">
          <Grid.RowDefinitions>
            <RowDefinition Height="430" />
            <RowDefinition Height="48" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0"
                  Background="#ffffff"
                  BorderBrush="#c8d6ee"
                  BorderThickness="1"
                  CornerRadius="8">
            <ScrollViewer Margin="18" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
              <TextBlock Text="{Binding LicenseText}"
                         FontFamily="Segoe UI"
                         FontSize="14"
                         LineHeight="20"
                         Foreground="#06123d"
                         TextWrapping="Wrap" />
            </ScrollViewer>
          </Border>
          <CheckBox Grid.Row="1"
                    Content="Saya telah membaca dan menyetujui perjanjian lisensi di atas"
                    Margin="0,12,0,0"
                    IsChecked="True"
                    FontFamily="Segoe UI"
                    FontSize="15"
                    Foreground="#204780" />
        </Grid>

        <Grid Margin="0,145,0,0" Width="620" Height="530" Visibility="{Binding OptionsVisibility}">
          <Border Width="600" Height="240" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#ffffff" BorderBrush="#d9e3f5" BorderThickness="1" CornerRadius="12">
            <StackPanel Margin="24">
              <TextBlock Text="Jenis Instalasi" FontFamily="Segoe UI" FontSize="20" FontWeight="Bold" Foreground="#06123d" />
              <RadioButton Content="Untuk semua pengguna"
                           GroupName="InstallScope"
                           Margin="8,24,0,0"
                           IsChecked="{Binding InstallForAllUsers, Mode=TwoWay}"
                           FontFamily="Segoe UI"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#06123d" />
              <TextBlock Text="Instal aplikasi untuk semua pengguna di komputer ini."
                         Margin="40,8,0,0"
                         FontFamily="Segoe UI"
                         FontSize="15"
                         Foreground="#52617d" />
              <RadioButton Content="Hanya untuk saya (asus)"
                           GroupName="InstallScope"
                           Margin="8,22,0,0"
                           IsChecked="{Binding InstallForCurrentUser, Mode=TwoWay}"
                           FontFamily="Segoe UI"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#06123d" />
              <TextBlock Text="Instal aplikasi hanya untuk akun pengguna saat ini."
                         Margin="40,8,0,0"
                         FontFamily="Segoe UI"
                         FontSize="15"
                         Foreground="#52617d" />
            </StackPanel>
          </Border>
          <Border Margin="0,262,0,0" Width="600" Height="150" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#ffffff" BorderBrush="#d9e3f5" BorderThickness="1" CornerRadius="12">
            <StackPanel Margin="24">
              <TextBlock Text="Opsi Tambahan" FontFamily="Segoe UI" FontSize="20" FontWeight="Bold" Foreground="#06123d" />
              <CheckBox Content="Buat shortcut di desktop" Margin="8,20,0,0" IsChecked="{Binding CreateDesktopShortcut, Mode=TwoWay}" FontFamily="Segoe UI" FontSize="17" Foreground="#06123d" />
              <CheckBox Content="Jalankan aplikasi setelah instalasi selesai" Margin="8,14,0,0" IsChecked="{Binding RunAfterInstall, Mode=TwoWay}" FontFamily="Segoe UI" FontSize="17" Foreground="#06123d" />
            </StackPanel>
          </Border>
          <Border Margin="0,434,0,0" Width="600" Height="70" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#fbfdff" BorderBrush="#d7e4f7" BorderThickness="1" CornerRadius="10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
              <Border Width="34" Height="34" CornerRadius="17" Background="#075ed6">
                <TextBlock Text="i" Foreground="White" FontFamily="Segoe UI" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="Ini adalah instalasi baru untuk pengguna asus."
                         Margin="18,0,0,0"
                         VerticalAlignment="Center"
                         FontFamily="Segoe UI"
                         FontSize="16"
                         Foreground="#204780" />
            </StackPanel>
          </Border>
        </Grid>

        <Grid Margin="0,205,0,0" Width="665" Height="430" Visibility="{Binding LocationVisibility}" Panel.ZIndex="20">
          <TextBlock Text="Folder Tujuan" VerticalAlignment="Top" FontFamily="Segoe UI" FontSize="17" FontWeight="SemiBold" Foreground="#06123d" />
          <Grid Margin="0,38,0,0" Width="650" Height="66" HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="30">
            <TextBox x:Name="InstallPathBox"
                     Width="506"
                     Height="61"
                     HorizontalAlignment="Left"
                     Padding="14,13,10,8"
                     FontFamily="Segoe UI"
                     FontSize="20"
                     Foreground="#06123d"
                     Background="#fbfdff"
                     BorderBrush="#c5d1e5"
                     BorderThickness="1"
                     Text="{Binding InstallPath, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="Browse..."
                    Width="138"
                    Height="61"
                    HorizontalAlignment="Right"
                    Style="{StaticResource SecondaryButton}"
                    Click="OnBrowse"
                    Panel.ZIndex="40" />
          </Grid>
          <StackPanel Margin="0,138,0,0" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
              <Border Width="32" Height="32" CornerRadius="6" Background="#dbe9ff">
                <Path Width="18" Height="18" Fill="#426aa8" Stretch="Uniform" Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="Ruang yang dibutuhkan: 441.7 MB"
                         Margin="18,0,0,0"
                         VerticalAlignment="Center"
                         FontFamily="Segoe UI"
                         FontSize="18"
                         Foreground="#172544" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Width="32" Height="32" CornerRadius="6" Background="#dbe9ff">
                <Path Width="18" Height="18" Fill="#426aa8" Stretch="Uniform" Data="M18,3H6C4.89,3 4,3.89 4,5V19C4,20.11 4.89,21 6,21H18C19.11,21 20,20.11 20,19V5C20,3.89 19.11,3 18,3ZM18,19H6V17H18V19ZM18,15H6V5H18V15Z" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="{Binding AvailableSpaceText}"
                         Margin="18,0,0,0"
                         VerticalAlignment="Center"
                         FontFamily="Segoe UI"
                         FontSize="18"
                         Foreground="#172544" />
            </StackPanel>
          </StackPanel>
        </Grid>

        <Grid Margin="0,175,0,0" Width="620" Height="540" Visibility="{Binding InstallingVisibility}">
          <TextBlock Text="Progres Instalasi" FontFamily="Segoe UI" FontSize="19" FontWeight="SemiBold" Foreground="#06123d" />
          <TextBlock Text="{Binding ProgressText}" Margin="552,-4,0,0" FontFamily="Segoe UI" FontSize="23" FontWeight="SemiBold" Foreground="#075ed6" />
          <ProgressBar Margin="0,42,0,0"
                       Width="595"
                       Height="28"
                       HorizontalAlignment="Left"
                       Minimum="0"
                       Maximum="100"
                       Value="{Binding ProgressValue, Mode=OneWay}"
                       Foreground="#0b67e8"
                       Background="#e6edf7"
                       BorderThickness="0" />
          <TextBlock Text="{Binding InstallStatus}" Margin="0,100,0,0" FontFamily="Segoe UI" FontSize="18" Foreground="#52617d" />
          <Border Margin="0,150,0,0" Width="595" Height="340" HorizontalAlignment="Left" Background="#ffffff" BorderBrush="#d9e3f5" BorderThickness="1" CornerRadius="12">
            <Grid Margin="24,22">
              <Grid.RowDefinitions>
                <RowDefinition Height="62" />
                <RowDefinition Height="62" />
                <RowDefinition Height="62" />
                <RowDefinition Height="62" />
                <RowDefinition Height="62" />
              </Grid.RowDefinitions>
              <Grid.Resources>
                <Style x:Key="InstallDot" TargetType="Border">
                  <Setter Property="Width" Value="30" />
                  <Setter Property="Height" Value="30" />
                  <Setter Property="CornerRadius" Value="15" />
                  <Setter Property="HorizontalAlignment" Value="Left" />
                  <Setter Property="VerticalAlignment" Value="Top" />
                </Style>
              </Grid.Resources>
              <Rectangle Grid.RowSpan="5" Width="2" Height="252" Margin="14,16,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="#d5e1f1" />
              <Grid Grid.Row="0">
                <Border Style="{StaticResource InstallDot}" Background="#2bc86b">
                  <TextBlock Text="&#x2713;" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="54,0,0,0">
                  <TextBlock Text="Core Installer" FontFamily="Segoe UI" FontSize="18" FontWeight="SemiBold" Foreground="#06123d" />
                  <TextBlock Text="Validasi folder, payload, dan permission Windows" Margin="0,6,0,0" FontFamily="Segoe UI" FontSize="15" Foreground="#52617d" />
                </StackPanel>
              </Grid>
              <Grid Grid.Row="1">
                <Border Style="{StaticResource InstallDot}" Background="#2bc86b">
                  <TextBlock Text="&#x2713;" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="54,0,0,0">
                  <TextBlock Text="Aplikasi Desktop Windows" FontFamily="Segoe UI" FontSize="18" FontWeight="SemiBold" Foreground="#06123d" />
                  <TextBlock Text="Electron runtime, UI native shell, asset, dan ikon" Margin="0,6,0,0" FontFamily="Segoe UI" FontSize="15" Foreground="#52617d" />
                </StackPanel>
              </Grid>
              <Grid Grid.Row="2">
                <Border Style="{StaticResource InstallDot}" Background="#eef5ff" BorderBrush="#075ed6" BorderThickness="5" />
                <StackPanel Margin="54,0,0,0">
                  <TextBlock Text="AI YOLO Offline" FontFamily="Segoe UI" FontSize="18" FontWeight="SemiBold" Foreground="#06123d" />
                  <TextBlock Text="Model ONNX, controller Raspberry Pi, dan runtime deteksi" Margin="0,6,0,0" FontFamily="Segoe UI" FontSize="15" Foreground="#52617d" />
                </StackPanel>
              </Grid>
              <Grid Grid.Row="3">
                <Border Style="{StaticResource InstallDot}" Background="#fbfdff" BorderBrush="#aab6c9" BorderThickness="4" />
                <StackPanel Margin="54,0,0,0">
                  <TextBlock Text="Peta, POI, Kamera Realtime" FontFamily="Segoe UI" FontSize="18" FontWeight="SemiBold" Foreground="#06123d" />
